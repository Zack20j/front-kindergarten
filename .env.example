# URL base del backend Spring Boot (sin slash final).
# Si no se define, el cliente usa http://localhost:8080 por defecto.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Mostrar los nombres del personal en /organigrama.
# Usa false si el sitio es público y solo quieres mostrar los cargos.
NEXT_PUBLIC_ORGANIGRAMA_MOSTRAR_NOMBRES=true
